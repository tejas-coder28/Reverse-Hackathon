# CooL AI Decision Evidence Platform Environment Configuration
# IMPORTANT: Never commit actual secret keys or credentials to git.

# Application Environment Domain
VITE_COOL_DOMAIN=nbfc.credit_scoring

# Hardware Enclave & TEE Attestation (Phala dstack)
VITE_ENABLE_TEE_ATTESTATION=true

# Institutional Model Metadata
VITE_MODEL_ID=CreditRisk-v3
VITE_MODEL_VERSION=3.4.1-prod

# Verification Protocol Mode
VITE_FAIL_CLOSED_SECURITY=true

# Institutional Cryptographic Key Management (Optional Override)
# Generate fresh keys with: npm run keys:generate
# In production, provide 64-character hexadecimal strings (32 bytes).
# If omitted, the application uses deterministic demo keys for offline/grading reproducibility.
# NEVER commit production secret keys to version control.
# VITE_ED25519_SECRET_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# VITE_MLDSA_SEED_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

